# Copy to .env and fill in. Do NOT commit .env.
# Default recipient for digest emails.
DIGEST_RECIPIENT=your.email@example.com
# Gmail account that sends the digest, and its 16-character App Password.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
GMAIL_SMTP_USER=your.email@gmail.com
GMAIL_APP_PASSWORD=your-app-password
